  };

  /* Edit layer macros — explicit modifier ordering (same pattern as flykey macros). */
  ed_undo: ed_undo {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings = <&macro_press &kp LGUI>, <&macro_tap &kp Z>, <&macro_release &kp LGUI>;
    display-name = "Undo";
  };
  ed_cut: ed_cut {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings = <&macro_press &kp LGUI>, <&macro_tap &kp X>, <&macro_release &kp LGUI>;
    display-name = "Cut";
  };
  ed_copy: ed_copy {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings = <&macro_press &kp LGUI>, <&macro_tap &kp C>, <&macro_release &kp LGUI>;
    display-name = "Copy";
  };
  ed_paste: ed_paste {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings = <&macro_press &kp LGUI>, <&macro_tap &kp V>, <&macro_release &kp LGUI>;
    display-name = "Paste";
  };
  ed_redo: ed_redo {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings =
      <&macro_press &kp LGUI>, <&macro_press &kp LSHFT>,
      <&macro_tap &kp Z>,
      <&macro_release &kp LSHFT>, <&macro_release &kp LGUI>;
    display-name = "Redo";
  };